{
  "name": "@paratco/async-modal",
  "version": "2.1.4",
  "description": "React async modal",
  "author": "Paratco",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Paratco/async-modal.git"
  },
  "keywords": [
    "React",
    "Modal",
    "Async"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "build": "NODE_ENV=production bun ./build.ts && bun run build:types",
    "build:types": "tsc -p ./tsconfig.build.json",
    "typecheck": "tsc -p ./tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "release": "semantic-release",
    "release-dry-debug": "semantic-release --no-ci -d --debug",
    "release-dry": "semantic-release --no-ci -d"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@paratco/eslint-config": "3.4.0",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/bun": "1.4.2",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "9.37.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "semantic-release": "25.0.9",
    "typescript": "6.0.3"
  }
}
